# Copy to .env.local and fill in. .env.local is gitignored.

# Liveblocks public key, from https://liveblocks.io/dashboard
#   → project → Settings → API keys → "Public key" (pk_dev_… or pk_prod_…)
#
# Public key only. The secret key (sk_…) must never be given a NEXT_PUBLIC_
# prefix — that bundles it into the browser.
#
# Left unset, the canvas simply renders without multiplayer cursors.
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# Room all visitors share. Change it to reset presence.
NEXT_PUBLIC_LIVEBLOCKS_ROOM=harbourhack-canvas


# ---------------------------------------------------------------- registration
#
# None of the keys below may ever take a NEXT_PUBLIC_ prefix. They are read only
# in app/api/manifest/route.ts and the modules it imports, all of which run on
# the server. A NEXT_PUBLIC_ prefix inlines the value into the browser bundle,
# which for any of these means handing out write access to the registration
# list and the ability to send mail as the event.
#
# Left unset, the form refuses the registration with a 503 and says so, rather
# than accepting it and dropping it on the floor.

# Airtable personal access token, from https://airtable.com/create/tokens
#   Scopes: data.records:read, data.records:write — on this base only.
AIRTABLE_TOKEN=

# The base id, from the API docs URL for your base: airtable.com/appXXXXXXXX/api/docs
AIRTABLE_BASE_ID=

# Table name. Defaults to "Registrations" when unset.
#
# The table needs these columns, spelled exactly:
#   Name · Email · Role · Skills · Looking for · Manifest no. · Registered
#
# Email is the merge field — registering twice updates the row rather than
# adding a second one — so it must be the primary field or otherwise unique.
AIRTABLE_TABLE=Registrations

# Resend API key, from https://resend.com/api-keys
# Unset, registrations still store; nobody gets a confirmation.
RESEND_API_KEY=

# The from address. Its domain has to be verified in Resend or everything
# bounces. Format: "HarbourHack <crew@harbourhack.com>"
REGISTRATION_FROM_EMAIL=
