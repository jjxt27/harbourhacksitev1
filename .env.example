# Application form delivery (app/api/apply/route.ts).
#
# With these unset, submissions are logged to the server console in
# development and the form still completes. In production, unset means the
# route returns 500 rather than silently dropping applications.

RESEND_API_KEY=
# Must be on a domain verified in Resend.
APPLY_FROM_EMAIL="HarbourHack <applications@yourdomain.com>"
# Where applications land.
APPLY_TO_EMAIL=
